# Copia este archivo como .env.local y completa los valores.
# Solo las variables con prefijo VITE_ llegan al navegador: NUNCA pongas aquí claves privadas.

# URL de la API Express (Fase 4)
VITE_API_URL=http://localhost:4000/api

# REST Countries v5 (Fase 3) — clave GRATUITA de https://restcountries.com/sign-up
# En "API Keys" agrega "localhost" (y tu dominio al desplegar) a los orígenes permitidos.
# Es una clave restringida por origen; en la Fase 4 la llamada pasará por el backend.
VITE_RESTCOUNTRIES_KEY=

# Supabase — SOLO la clave PUBLICABLE (sb_publishable_...), nunca la secreta.
# Se usa únicamente para Supabase Realtime (presencia de profesionales).
VITE_SUPABASE_URL=https://uerubfhrjspfiemgsufn.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Dominio público del frontend (canonical, Open Graph y sitemap.xml).
# Por defecto https://neuronote-monorepo.vercel.app
VITE_SITE_URL=

# Panel pericial del motor de auditoría (enlace "Acceso para auditores" del pie).
# Por defecto https://neuronote-audit.onrender.com/  ·  en local: http://localhost:8080/
VITE_AUDIT_URL=
