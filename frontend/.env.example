# Copia este archivo como .env.local y completa los valores.
# Solo las variables con prefijo VITE_ llegan al navegador: NUNCA pongas aquí claves privadas.

# URL de la API Express (Fase 4)
VITE_API_URL=http://localhost:4000/api

# Supabase (Fase 4) — usa únicamente la clave pública "anon"/"publishable", nunca la service_role
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
