# Copia como audit-engine/.env (no se sube a Git).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=neuronote_audit
DB_USER=neuronote_app
DB_PASS=
# Solo para bases en la nube con TLS (TiDB Cloud). En local, déjalo vacío.
# En la imagen Docker ya vale /etc/ssl/certs/ca-certificates.crt
DB_SSL_CA=
# 1 = confiar en X-Forwarded-Proto (detrás del proxy de Render). En local, vacío.
TRUST_PROXY=

# Acceso al panel administrativo pericial (index.php)
ADMIN_USER=admin
# Contraseña larga; se compara con password_verify contra este hash:
#   C:\xampp\php\php.exe -r "echo password_hash('TU_CONTRASEÑA', PASSWORD_DEFAULT);"
ADMIN_PASS_HASH=

# Clave para firmar los sellos (HMAC). Genérala con:
#   C:\xampp\php\php.exe -r "echo bin2hex(random_bytes(32));"
BADGE_SECRET=
