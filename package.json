  "version": "0.1.0",
  "description": "NEURONOTE (NEUROROUTE): plataforma geoespacial de descompresión sensorial y movilidad urbana.",
  "license": "MIT",
  "scripts": {
    "install:frontend": "npm install --prefix frontend",
    "dev": "npm run dev --prefix frontend",
