    "preview": "npm run preview --prefix frontend",
    "php:version": "C:/xampp/php/php.exe -v",
    "audit:serve": "C:/xampp/php/php.exe -S localhost:8080 -t audit-engine"
  },
  "engines": {
    "node": ">=20.19"
  }
}
