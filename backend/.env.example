# Copia este archivo como backend/.env (NUNCA lo subas a Git).
# Sin Supabase ni MongoDB configurados, la API arranca en "modo memoria":
# funciona para probar, pero los datos se pierden al reiniciar.

PORT=4000
NODE_ENV=development
# Orígenes permitidos (separados por coma)
CORS_ORIGIN=http://localhost:5173

# JWT — un secreto largo y aleatorio. Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Supabase (proyecto "neuronote"). La clave SECRETA solo vive en el servidor.
# Panel de Supabase → Project Settings → API Keys → "Secret keys"
SUPABASE_URL=https://uerubfhrjspfiemgsufn.supabase.co
SUPABASE_SECRET_KEY=

# MongoDB Atlas (clúster gratuito M0) — cadena "mongodb+srv://..."
MONGODB_URI=

# REST Countries v5 (la clave pasa del frontend al servidor)
RESTCOUNTRIES_KEY=

# Motor de auditoría PHP (XAMPP) para consultar certificaciones
AUDIT_ENGINE_URL=http://localhost:8080
