# Copia como backend/.env (nunca lo subas a Git). Se usa a partir de la Fase 4.
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT — genera un secreto largo y aleatorio en tu máquina
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Supabase (la service_role SOLO vive aquí, en el servidor)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# MongoDB Atlas (clúster gratuito M0)
MONGODB_URI=
